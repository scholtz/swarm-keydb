SWARM_KEYDB_IMAGE=scholtz2/swarm-keydb:zero-day
SWARM_KEYDB_BIND=0.0.0.0
SWARM_KEYDB_PORT=6379
SWARM_KEYDB_BACKEND=bee
SWARM_KEYDB_DATA_DIR=/data
BEE_URL=http://swarm-bee:1633
BEE_POSTAGE_BATCH_ID=replace-with-postage-batch-id
BEE_PASSWORD=replace-with-strong-password
BEE_MAINNET=false
BEE_FULL_NODE=true
BEE_SWAP_ENABLE=true
BEE_API_ADDR=0.0.0.0:1633
BEE_P2P_ADDR=:1634
BEE_NAT_ADDR=
BEE_BLOCKCHAIN_RPC_ENDPOINT=https://sepolia.infura.io/v3/replace-with-project-id