{
  "title": "SwarmKeyDb Consistency Health",
  "uid": "swarmkeydb-consistency-health",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Drift Reconciliation Rate",
      "targets": [
        {
          "expr": "rate(swarmkeydb_cache_drift_total[5m])",
          "legendFormat": "drift/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Resync Frequency",
      "targets": [
        {
          "expr": "increase(swarmkeydb_resync_partial_total[15m])",
          "legendFormat": "partial"
        },
        {
          "expr": "increase(swarmkeydb_resync_full_total[15m])",
          "legendFormat": "full"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Verification Failure Rate",
      "targets": [
        {
          "expr": "rate(swarmkeydb_cache_verification_fail_total[5m])",
          "legendFormat": "verification-failures/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Sync Lag (Pending Reconciliations)",
      "targets": [
        {
          "expr": "swarmkeydb_sync_lag_keys",
          "legendFormat": "lag"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Transactions Started / Committed / Aborted",
      "targets": [
        {
          "expr": "rate(swarmkeydb_transaction_started_total[5m])",
          "legendFormat": "started/s"
        },
        {
          "expr": "rate(swarmkeydb_transaction_committed_total[5m])",
          "legendFormat": "committed/s"
        },
        {
          "expr": "rate(swarmkeydb_transaction_aborted_total[5m])",
          "legendFormat": "aborted/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "WATCH Conflict Rate",
      "targets": [
        {
          "expr": "rate(swarmkeydb_transaction_watch_conflict_total[5m])",
          "legendFormat": "watch-conflicts/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Transaction Queue Depth Distribution",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(swarmkeydb_transaction_queue_depth_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(swarmkeydb_transaction_queue_depth_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(swarmkeydb_transaction_queue_depth_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "EXEC Latency (p50/p95/p99)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(swarmkeydb_transaction_exec_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(swarmkeydb_transaction_exec_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(swarmkeydb_transaction_exec_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Script Cache Replication",
      "targets": [
        {
          "expr": "swarmkeydb_script_cache_size",
          "legendFormat": "cache-size"
        },
        {
          "expr": "rate(swarmkeydb_script_replication_sent_total[5m])",
          "legendFormat": "sent/s"
        },
        {
          "expr": "rate(swarmkeydb_script_replication_received_total[5m])",
          "legendFormat": "received/s"
        },
        {
          "expr": "rate(swarmkeydb_script_cache_miss_recovered_total[5m])",
          "legendFormat": "miss-recovered/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP REST Throughput",
      "targets": [
        {
          "expr": "sum(rate(swarmkeydb_http_requests_total[5m]))",
          "legendFormat": "requests/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP REST Latency (p50/p95/p99)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(swarmkeydb_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(swarmkeydb_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(swarmkeydb_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      }
    }
  ]
}
